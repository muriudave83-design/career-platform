generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String     @id @default(cuid())
  email     String     @unique
  password  String
  course    String?
  location  String?
  createdAt DateTime   @default(now())
  role      String     @default("USER")
  bookmarks Bookmark[]
  payments  Payment[]
}

model Listing {
  id           String     @id @default(cuid())
  title        String
  company      String
  location     String
  description  String
  isVerified   Boolean    @default(false)
  isUrgent     Boolean    @default(false)
  isHighAccept Boolean    @default(false)
  difficulty   String?
  tips         String?
  createdAt    DateTime   @default(now())
  isPremium    Boolean    @default(false)
  applyUrl     String?
  bookmarks    Bookmark[]
  payments     Payment[]
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  createdAt DateTime @default(now())
  listing   Listing  @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
}

model Report {
  id        String   @id @default(cuid())
  message   String
  listingId String?
  createdAt DateTime @default(now())
}

model Payment {
  id        String   @id @default(cuid())
  userId    String
  amount    Int
  status    String
  createdAt DateTime @default(now())
  listingId String?
  phone     String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, listingId])
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  imageUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}